{
  "name": "fieldledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, self-hosted field operations and group lending records for NGOs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node backend/server.mjs",
    "dev": "node --watch backend/server.mjs",
    "test": "node --import ./tests/setup.mjs --test tests/*.test.mjs",
    "restore": "node backend/scripts/restore.mjs",
    "encrypt-db": "node backend/scripts/encrypt-database.mjs",
    "demo:exchange": "node backend/scripts/demo-exchange.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.4"
  }
}
