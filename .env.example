# Used by Docker Compose. Copy to .env and replace before starting.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Set true when accessed over HTTPS through your reverse proxy.
COOKIE_SECURE=false
# Optional canonical external origin, e.g. https://fieldledger.your-ngo.org
# APP_ORIGIN=https://fieldledger.your-ngo.org

# Generate independently of ADMIN_PASSWORD; retain outside the data volume.
DATABASE_KEY=replace-with-a-random-secret-of-at-least-32-characters
